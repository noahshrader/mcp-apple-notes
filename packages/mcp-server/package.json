{
  "name": "@noahshrader/mcp-apple-notes",
  "version": "1.0.0",
  "private": false,
  "description": "MCP server for Apple Notes — search, read, create, append, and sync notes via the Model Context Protocol.",
  "license": "MIT",
  "author": "Noah Shrader <noahshrader@gmail.com> (https://github.com/noahshrader)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahshrader/mcp-apple-notes.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/noahshrader/mcp-apple-notes#readme",
  "keywords": [
    "mcp",
    "apple-notes",
    "macos",
    "automation",
    "server"
  ],
  "type": "module",
  "bin": {
