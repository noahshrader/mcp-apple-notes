{
  "name": "@mcp-apple-notes/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local command-line boundary for Apple Notes workflows.",
  "type": "module",
  "bin": {
    "mcp-apple-notes": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@mcp-apple-notes/notes-adapter": "0.1.0",
    "@mcp-apple-notes/storage": "0.1.0"
  }
}
