  "description": "Sync Apple Notes folders into a local JSON cache with checklist extraction — no Electron or MCP dependencies.",
  "license": "MIT",
  "author": "Noah Shrader <noahshrader@gmail.com> (https://github.com/noahshrader)",
  "repository": {
    "type": "git",
