{
  "name": "mcp-apple-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Apple Notes intelligence system with reusable adapter, MCP tools, portable skills, and CLI workflows.",
  "license": "MIT",
  "author": "Noah Shrader <noahshrader@gmail.com> (https://github.com/noahshrader)",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahshrader/mcp-apple-notes.git"
  },
  "homepage": "https://github.com/noahshrader/mcp-apple-notes#readme",
  "keywords": [
    "mcp",
    "apple-notes",
    "macos",
    "automation",
    "notes"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build:mcp": "npm run build -w packages/mcp-server",
    "pack:mcp": "npm pack -w packages/mcp-server --dry-run",
    "cli": "node packages/cli/dist/index.js",
    "clean": "tsc -b --clean",
    "test": "npm run typecheck && node --test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
